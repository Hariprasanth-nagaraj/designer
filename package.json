{
  "name": "@hari-prasanth-nagaraj/designer",
  "version": "1.1.0",
  "description": "An evidence-driven product-UI design workflow for coding agents: tier router, Design Director, coupled design grammar, contextual reference selection, static drift checking, browser review and user-flow testing. Not an application, framework or component library.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "design",
    "design-system",
    "design-tokens",
    "ui",
    "ux",
    "accessibility",
    "agent-skill",
    "ai",
    "codex",
    "claude-code",
    "cursor",
    "pi",
    "linter"
  ],
  "files": [
    "SKILL.md",
    "references/",
    "scripts/",
    "lib/",
    "data/",
    "benchmarks/",
    "examples/",
    "adapters/",
    "docs/",
    "tests/",
    "licenses/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "bin": {
    "designer-doctor": "./scripts/doctor.mjs",
    "designer-setup": "./scripts/setup.mjs",
    "designer-install-agent": "./scripts/install-agent.mjs",
    "designer-uninstall-agent": "./scripts/uninstall-agent.mjs",
    "designer-pick-references": "./scripts/pick-references.mjs",
    "designer-record": "./scripts/record.mjs",
    "designer-design-drift": "./scripts/design-drift.mjs",
    "designer-design-audit": "./scripts/design-audit.mjs",
    "designer-benchmark": "./benchmarks/run-benchmark.mjs"
  },
  "pi": {
    "skills": [
      "."
    ]
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build-index": "node scripts/build-reference-index.mjs",
    "test": "node tests/run-tests.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "optionalDependencies": {},
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "enginesNote": "Core tools need zero dependencies. Browser features need Playwright, installed separately: npx playwright install chromium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hariprasanth-nagaraj/designer.git"
  },
  "bugs": {
    "url": "https://github.com/Hariprasanth-nagaraj/designer/issues"
  },
  "homepage": "https://github.com/Hariprasanth-nagaraj/designer#readme"
}
