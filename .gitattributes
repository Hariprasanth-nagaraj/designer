# Normalize line endings in the repository; check out with the platform default.
* text=auto eol=lf

*.mjs text eol=lf
*.js  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
