{
  "version": 1,
  "note": "Placement registry, not compatibility certification. detect checks configuration markers only. Native discovery/invocation must be tested in the target client; all clients support the manual read-SKILL bridge when allowed to read local files.",
  "agents": [
    {
      "id": "universal",
      "label": "Universal / Agent Skills spec",
      "confidence": "placement",
      "dirs": [
        "~/.agents/skills"
      ],
      "detect": [
        "~/.agents"
      ],
      "notes": "The cross-vendor standard location. Most newer agents read this. Installing here is the safest default if you are unsure.",
      "projectDirs": [
        ".agents/skills"
      ]
    },
    {
      "id": "pi",
      "label": "pi",
      "confidence": "placement",
