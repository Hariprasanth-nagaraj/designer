{
  "version": 1,
  "note": "Agent skill-install registry. `dirs` is where the skill is installed (user scope); `detect` is what proves the agent is installed. `confidence: verified` means confirmed against a real install on a working machine; `documented` means the convention is known but unconfirmed here. Add your own agent by copying an entry — nothing else needs to change.",
  "agents": [
    {
      "id": "universal",
      "label": "Universal / Agent Skills spec",
      "confidence": "verified",
      "dirs": ["~/.agents/skills"],
      "detect": ["~/.agents"],
      "notes": "The cross-vendor standard location. Most newer agents read this. Installing here is the safest default if you are unsure."
    },
    {
      "id": "pi",
      "label": "pi",
      "confidence": "verified",
      "dirs": ["~/.pi/agent/skills"],
      "detect": ["~/.pi"],
